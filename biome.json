{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/.claude",
			"!**/coverage",
			"!**/dist",
			"!**/node_modules",
			"!**/plans",
			"!**/temp",
			"!**/*.md",
			"!**/*.mdc",
			"!**/*.yml",
			"!**/tsconfig.json",
			"!**/tsconfig.base.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"quoteProperties": "asNeeded",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noBannedTypes": "off"
			},
			"correctness": {
				"noUnusedFunctionParameters": "off",
				"noUnusedImports": "warn",
				"noUnusedVariables": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "off",
				"noRedeclare": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/__tests__/**", "**/conformance/**"],
			"linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
