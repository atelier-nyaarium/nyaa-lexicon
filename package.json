{
	"name": "nyaa-lexicon",
	"version": "3.2.2",
	"private": true,
	"type": "module",
	"description": "Symbol-level code understanding served to agents over MCP and to editors over LSP",
	"workspaces": [
		"protocol",
		"client",
		"core",
		"formats",
		"adapters/*",
		"providers/*"
	],
	"scripts": {
		"build": "bun run scripts/build.ts",
		"lint": "bun run scripts/lint.ts",
		"lint:fix": "biome check --write .",
		"test": "bun test --parallel --timeout 30000 --path-ignore-patterns '**/temp/**' --path-ignore-patterns '**/dist/**'",
		"test:watch": "bun test --watch --timeout 30000 --path-ignore-patterns '**/temp/**' --path-ignore-patterns '**/dist/**'",
		"clean": "bunx tsc --build --clean"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"bun-types": "1.4.0",
		"typescript": "6.0.3"
	}
}
